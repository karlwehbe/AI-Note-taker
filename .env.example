# =============================================================================
# Server / runtime
# =============================================================================

# development | staging | production
ENVIRONMENT=development

# SQLAlchemy URL (local compose default shown). This is the day-to-day dev
# database — safe to wipe and reset freely (./setup.sh --reset).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_note_taker

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Deepgram API key for transcription (batch uploads + live streaming) —
# get one at console.deepgram.com
DEEPGRAM_API_KEY=

# LLM used for notes writing, chat replies, and the profile compile.
# "provider:model" — passed straight to LangChain's init_chat_model, so
# swapping providers is this string plus the matching key below.
LLM_MODEL=openai:gpt-5.6-luna
# Separate model for the yes/no "should we touch the notes?" router only.
# Keep this cheaper/faster than LLM_MODEL — it's a classification call that
# runs on every single turn.
ROUTING_LLM_MODEL=openai:gpt-5.4-nano
OPENAI_API_KEY=

# =============================================================================
# Client (Vite) — prefix with VITE_ to expose to the browser
# =============================================================================

VITE_API_URL=http://localhost:8000
